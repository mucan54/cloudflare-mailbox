# Generated by `php artisan cf:deploy-worker` — DO NOT edit the rendered
# wrangler.toml by hand; edit this stub or the Laravel config instead.
name = "{{WORKER_NAME}}"
main = "src/inbound-email.js"
account_id = "{{ACCOUNT_ID}}"
compatibility_date = "2024-11-01"
compatibility_flags = ["nodejs_compat"]

[vars]
WEBHOOK_URL = "{{WEBHOOK_URL}}"
ACCOUNT_ID = "{{ACCOUNT_ID}}"
INLINE_ATTACHMENT_MAX = "{{INLINE_ATTACHMENT_MAX}}"
FALLBACK_FORWARD_TO = "{{FALLBACK_FORWARD_TO}}"

# WEBHOOK_SECRET is a secret, injected via `wrangler secret put` — never a var.

# Optional: large-attachment offload to R2. Uncomment and create the bucket to
# stream attachments over the inline size limit straight to R2.
# [[r2_buckets]]
# binding = "ATTACHMENTS"
# bucket_name = "{{WORKER_NAME}}-attachments"
